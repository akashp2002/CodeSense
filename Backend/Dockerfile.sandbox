FROM python:3.11-slim

RUN apt-get update && apt-get install -y git && rm -rf /var/lib/apt/lists/*
RUN pip install "mcp<2" fastmcp PyGithub tree-sitter-python tree-sitter pydantic anyio
RUN git config --global --add safe.directory '*'

WORKDIR /repo
ENV PYTHONPATH=/app
ENTRYPOINT ["python", "-m", "codesense.mcp.server"]
